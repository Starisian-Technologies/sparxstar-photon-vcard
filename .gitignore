# SPARXSTAR Photon VCard — .gitignore
# Based on: https://github.com/github/gitignore/blob/main/WordPress.gitignore

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
.npm/

# ── Built assets (generated by CI from src/ — do not commit manually) ────────
assets/css/sparxstar-photon-vcard.min.css
assets/js/sparxstar-photon-vcard.min.js

# ── PHP / Composer ────────────────────────────────────────────────────────────
# vendor/ is committed for reproducible CI builds (no Packagist dependency at runtime)
# .phpunit.cache/ and PHPStan tmp directories are local only
.phpunit.cache/
.phpunit.result.cache
/tmp/

# ── OS and editor artefacts ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
wp-config.php
wp-config-local.php

# ── Log files ─────────────────────────────────────────────────────────────────
*.log
debug.log

# ── Release archives ──────────────────────────────────────────────────────────
*.zip
*.tar.gz

# ── WordPress core (if this repo is placed inside a WP installation) ─────────
/wp-admin/
/wp-content/index.php
/wp-content/languages/
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php
/.htaccess

# WP configuration
wp-config-sample.php

# Example themes
/wp-content/themes/twenty*/

# Example plugin
/wp-content/plugins/hello.php

# Uploads
/wp-content/uploads/

# All plugins (uncomment to exclude everything but this plugin)
#/wp-content/plugins/

# All themes (uncomment to exclude all themes)
#/wp-content/themes/